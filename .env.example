# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Get these from the Clerk dashboard for this project's application: https://dashboard.clerk.com

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The Django backend's URL. Defaults to http://localhost:8000 for local dev
# if left unset - only needs to be set explicitly once the backend is deployed.
NEXT_PUBLIC_API_BASE_URL=
