# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Get these from the Clerk dashboard for this project's application: https://dashboard.clerk.com

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The Django backend's URL. Defaults to http://localhost:8000 for local dev
# if left unset - only needs to be set explicitly once the backend is deployed.
NEXT_PUBLIC_API_BASE_URL=

# --- Error tracking (Sentry), optional ------------------------------------------
# Off unless NEXT_PUBLIC_SENTRY_DSN is set - a build with no key configured just
# runs normally. Create a free project at https://sentry.io, then set both of
# these to its DSN (same value in both - one is for the browser, one for the
# server/edge runtimes). The backend has its own separate SENTRY_DSN, see
# backend/.env.example.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
#
# Only needed if you also want source maps uploaded to Sentry on every build
# (better stack traces). From Sentry's org settings and auth token page.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
