# Copy to backend/.env for local development. Never commit .env.
# On a real server set these as environment variables instead of using a file.

# --- Local development: only this is needed besides CLERK_ISSUER ---------------
# Turns on debug mode. Leave it OUT on a server: without it Django runs in
# production mode and refuses to start unless DJANGO_SECRET_KEY is set.
DJANGO_DEBUG=True

# The Clerk "Issuer" used to verify session tokens sent from the frontend.
# e.g. https://your-app.clerk.accounts.dev (dev) or your production Frontend
# API domain. Find it in the Clerk dashboard under API Keys > Advanced, or
# decode any Clerk session token and read its "iss" claim.
# NOTE: the production Clerk instance has a different issuer than dev.
CLERK_ISSUER=

# --- Production: required on a server ------------------------------------------
# Long random value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(60))"
# DJANGO_SECRET_KEY=

# This backend's own hostname(s), comma separated, e.g. api.unitedpsa.org
# DJANGO_ALLOWED_HOSTS=

# The website's origin(s), comma separated, with https:// and no trailing slash.
# List every variant people visit, e.g. https://unitedpsa.org,https://www.unitedpsa.org
# Also used to reject Clerk tokens that were issued for a different site.
# FRONTEND_ORIGINS=

# Postgres connection string from your host, e.g. postgres://user:pass@host:5432/dbname
# Unset = local sqlite file (development only).
# DATABASE_URL=

# --- Production: file storage (Cloudflare R2) ----------------------------------
# Without these, uploads go to local disk, which is wiped on every deploy.
# Two buckets on purpose: photos are public, resumes must stay private.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PRIVATE_BUCKET=      # resumes: NO public access on this bucket
# R2_PUBLIC_BUCKET=       # profile photos: attach a public domain to this bucket
# R2_PUBLIC_BASE_URL=     # that public URL, e.g. https://photos.unitedpsa.org

# --- Email notifications (optional) ------------------------------------------------
# Members get an email when they receive a request, have one accepted, or get a
# message (never including what was written). It needs two things: the Clerk
# secret key, used only to look up a member's address at send time (addresses
# are not stored in this database), and an SMTP account to send from.
# In local development, with DJANGO_DEBUG=True and CLERK_SECRET_KEY set, emails
# are printed to the server log instead of being sent.
# CLERK_SECRET_KEY=          # same key as the frontend's CLERK_SECRET_KEY
# EMAIL_HOST=                # e.g. smtp.resend.com, smtp-relay.brevo.com, smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=UPSA Portal <no-reply@unitedpsa.org>   # must be an address your SMTP provider allows
# PORTAL_BASE_URL=           # where email links point; defaults to the first FRONTEND_ORIGINS entry

# --- Scaling (optional, recommended once you run more than one server) ------------------
# Shared cache so rate limits and the email cooldown count correctly across servers.
# REDIS_URL=redis://default:password@host:6379
# Number of gunicorn worker processes (default 3, each running 4 threads).
# WEB_CONCURRENCY=3

# --- Optional --------------------------------------------------------------------
# Set to false only if your host already redirects http to https for you.
# DJANGO_SSL_REDIRECT=true
